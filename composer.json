{
    "name": "psc-acme/core-product",
    "description": "Package core-product for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\CoreProduct\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.0",
        "symfony/validator": "^7.0",
        "symfony/cache": "^7.0",
        "psc-acme/processor-cart": "^1.0",
        "psc-acme/notifier-cart": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.27"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}